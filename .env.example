# Copy this file to .env and fill in the keys. Never put real keys in this file.
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# Node server (demo shop, experiments)
PORT=8787

# Python backend (website analysis)
BACKEND_PORT=8788

# live = real research. mock = fixtures only, always labelled SIMULAT.
ANALYSIS_MODE=live

# Optional. Pins CORS to your unpacked extension ID from chrome://extensions.
EXTENSION_ID=
